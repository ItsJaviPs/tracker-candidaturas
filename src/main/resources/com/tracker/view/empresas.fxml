<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="24.0" xmlns="http://javafx.com/javafx/24" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tracker.controller.EmpresasController">
   <padding>
      <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
   </padding>
   <children>
      <VBox spacing="16.0" HBox.hgrow="ALWAYS">
         <children>
            <HBox alignment="CENTER_LEFT">
               <children>
                  <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Empresas" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button mnemonicParsing="false" onAction="#nueva" style="-fx-background-color: #1F4E8C; -fx-text-fill: white; -fx-font-weight: bold;" text="+ Nueva empresa" />
               </children>
            </HBox>
            <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colNombre" prefWidth="180.0" text="Nombre" />
                  <TableColumn fx:id="colSector" prefWidth="140.0" text="Sector" />
                  <TableColumn fx:id="colWeb" prefWidth="220.0" text="Web" />
                  <TableColumn fx:id="colOfertas" prefWidth="80.0" text="Ofertas" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
      <VBox maxHeight="-Infinity" prefWidth="360.0" spacing="12.0" style="-fx-background-color: white; -fx-border-color: #D5DBE5; -fx-border-radius: 8; -fx-background-radius: 8;">
         <padding>
            <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
         </padding>
         <children>
            <Label fx:id="etiquetaFormulario" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Nueva empresa" />
            <VBox spacing="4.0">
               <children>
                  <Label style="-fx-font-weight: bold;" text="Nombre *" />
                  <TextField fx:id="campoNombre" />
               </children>
            </VBox>
            <VBox spacing="4.0">
               <children>
                  <Label style="-fx-font-weight: bold;" text="Sector *" />
                  <TextField fx:id="campoSector" promptText="Tecnología, consultoría, banca…" />
               </children>
            </VBox>
            <VBox spacing="4.0">
               <children>
                  <Label style="-fx-font-weight: bold;" text="Web" />
                  <TextField fx:id="campoWeb" promptText="https://…" />
               </children>
            </VBox>
            <VBox spacing="4.0">
               <children>
                  <Label style="-fx-font-weight: bold;" text="Fecha de registro" />
                  <DatePicker fx:id="fechaRegistro" />
               </children>
            </VBox>
            <Label fx:id="mensaje" style="-fx-text-fill: #C62828; -fx-font-weight: bold;" wrapText="true" />
            <HBox spacing="12.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#guardar" style="-fx-background-color: #1F4E8C; -fx-text-fill: white; -fx-font-weight: bold;" text="Guardar" />
                  <Button mnemonicParsing="false" onAction="#nueva" text="Nueva" />
                  <Button mnemonicParsing="false" onAction="#eliminar" style="-fx-background-color: #C62828; -fx-text-fill: white; -fx-font-weight: bold;" text="Eliminar" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</HBox>
