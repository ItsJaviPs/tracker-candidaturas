<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="24.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tracker.controller.EmpresasController">
   <padding>
      <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
   </padding>
   <children>
      <VBox spacing="16.0" HBox.hgrow="ALWAYS">
         <children>
            <HBox alignment="CENTER_LEFT">
               <children>
                  <Label styleClass="titulo" text="Empresas" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button mnemonicParsing="false" onAction="#nueva" styleClass="boton-primario" text="+ Nueva empresa" />
               </children>
            </HBox>
            <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colNombre" prefWidth="180.0" text="Nombre" />
                  <TableColumn fx:id="colSector" prefWidth="140.0" text="Sector" />
                  <TableColumn fx:id="colWeb" prefWidth="220.0" text="Web" />
                  <TableColumn fx:id="colOfertas" prefWidth="80.0" text="Ofertas" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
      <VBox maxHeight="-Infinity" prefWidth="440.0" spacing="12.0" styleClass="tarjeta">
         <padding>
            <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
         </padding>
         <children>
            <Label fx:id="etiquetaFormulario" styleClass="subtitulo" text="Nueva empresa" />
            <VBox spacing="4.0">
               <children>
                  <Label styleClass="etiqueta-campo" text="Nombre *" />
                  <TextField fx:id="campoNombre" />
               </children>
            </VBox>
            <VBox spacing="4.0">
               <children>
                  <Label styleClass="etiqueta-campo" text="Sector *" />
                  <TextField fx:id="campoSector" promptText="Tecnología, consultoría, banca…" />
               </children>
            </VBox>
            <VBox spacing="4.0">
               <children>
                  <Label styleClass="etiqueta-campo" text="Web" />
                  <TextField fx:id="campoWeb" promptText="https://www.empresa.com" />
               </children>
            </VBox>
            <VBox spacing="4.0">
               <children>
                  <Label styleClass="etiqueta-campo" text="Fecha de registro" />
                  <DatePicker fx:id="fechaRegistro" />
               </children>
            </VBox>
            <Label fx:id="mensaje" styleClass="mensaje-error" wrapText="true" />
            <HBox spacing="12.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#guardar" styleClass="boton-primario" text="Guardar empresa" />
                  <Button mnemonicParsing="false" onAction="#nueva" styleClass="boton-secundario" text="Nueva" />
                  <Button mnemonicParsing="false" onAction="#eliminar" styleClass="boton-peligro" text="Eliminar" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</HBox>
