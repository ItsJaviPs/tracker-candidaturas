<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tracker.controller.ListadoController">
   <padding>
      <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT">
         <children>
            <Label styleClass="titulo" text="Candidaturas" />
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#nueva" styleClass="boton-primario" text="+ Nueva candidatura" />
         </children>
      </HBox>
      <FlowPane hgap="12.0" vgap="8.0">
         <children>
            <VBox spacing="4.0">
               <children>
                  <Label text="Buscar" />
                  <TextField fx:id="campoBuscar" onAction="#buscar" prefWidth="200.0" promptText="Título o empresa…" styleClass="boton-primario" />
               </children>
            </VBox>
            <VBox spacing="4.0">
               <children>
                  <Label text="Estado" />
                  <ComboBox fx:id="comboEstado" prefWidth="130.0" promptText="Todos" />
               </children>
            </VBox>
            <VBox spacing="4.0">
               <children>
                  <Label text="Empresa" />
                  <TextField fx:id="campoEmpresa" onAction="#buscar" prefWidth="140.0" promptText="Todas" />
               </children>
            </VBox>
            <VBox spacing="4.0">
               <children>
                  <Label text="Salario mínimo (€)" />
                  <TextField fx:id="campoSalarioMin" onAction="#buscar" prefWidth="110.0" />
               </children>
            </VBox>
            <VBox spacing="4.0">
               <children>
                  <Label text="Salario máximo (€)" />
                  <TextField fx:id="campoSalarioMax" onAction="#buscar" prefWidth="110.0" />
               </children>
            </VBox>
            <VBox spacing="4.0">
               <children>
                  <Label text="Desde" />
                  <DatePicker fx:id="fechaDesde" prefWidth="130.0" />
               </children>
            </VBox>
            <VBox spacing="4.0">
               <children>
                  <Label text="Hasta" />
                  <DatePicker fx:id="fechaHasta" prefWidth="130.0" />
               </children>
            </VBox>
         </children>
      </FlowPane>
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <Button defaultButton="true" mnemonicParsing="false" onAction="#buscar" styleClass="boton-primario" text="Buscar" />
            <Button mnemonicParsing="false" onAction="#limpiar" styleClass="boton-secundario" text="Limpiar" />
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#ver" styleClass="boton-secundario" text="Ver" />
            <Button mnemonicParsing="false" onAction="#editar" styleClass="boton-secundario" text="Editar" />
            <Button mnemonicParsing="false" onAction="#eliminar" styleClass="boton-peligro" text="Eliminar" />
            <Button mnemonicParsing="false" onAction="#importarCsv" styleClass="boton-secundario" text="Importar CSV…" />
         </children>
      </HBox>
      <TableView fx:id="tabla" editable="true" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
            <TableColumn fx:id="colTitulo" prefWidth="320.0" text="Título" />
            <TableColumn fx:id="colEmpresa" prefWidth="160.0" text="Empresa" />
            <TableColumn fx:id="colEstado" prefWidth="130.0" text="Estado" />
            <TableColumn fx:id="colFecha" prefWidth="120.0" text="Fecha" />
            <TableColumn fx:id="colSalario" prefWidth="120.0" text="Salario" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <Label fx:id="etiquetaTotal" text="Mostrando 0 candidaturas" />
   </children>
</VBox>
